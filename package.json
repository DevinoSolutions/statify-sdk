{
    "name": "@devinosolutions/statify-sdk",
    "version": "0.1.0",
    "description": "Official TypeScript SDK for the Statify public API (app.statify.now/v1): app-store, web and product analytics, read-only.",
    "license": "MIT",
    "author": "Devino Solutions",
    "homepage": "https://statify.now",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DevinoSolutions/statify-sdk.git"
    },
    "bugs": {
        "url": "https://github.com/DevinoSolutions/statify-sdk/issues"
    },
    "keywords": [
        "statify",
        "analytics",
        "app-store",
        "google-play",
        "api",
        "sdk"
    ],
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@10.34.7",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:live": "vitest run test/live.test.ts",
        "changeset": "changeset",
        "version": "changeset version",
        "smoke:dist": "node scripts/smoke-dist.mjs"
    },
    "devDependencies": {
        "@changesets/cli": "2.31.1",
        "@types/node": "22.20.5",
        "tsup": "8.5.1",
        "typescript": "5.9.3",
        "vitest": "5.0.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
